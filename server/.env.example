# Copia este archivo como server/.env (no se sube a git) y llena tus claves.

# DeepSeek: https://platform.deepseek.com → API keys
DEEPSEEK_API_KEY=sk-...

# Voz de Billy: piper (solo Piper, por defecto y lo más rápido), piper_rvc (Piper + RVC, lento en CPU) o polly
TTS_ENGINE=piper
PIPER_VOICE=models/piper/es_MX-claude-high.onnx
# RVC (rutas relativas a server/). Tono en semitonos; f0: pm (rápido) o rmvpe (más preciso, más lento)
RVC_MODEL=models/Jorge-v2/model.pth
RVC_INDEX=models/Jorge-v2/model.index
RVC_PITCH=-13
RVC_F0=pm

# AWS (para Polly). Un usuario IAM con el permiso AmazonPollyReadOnlyAccess basta.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Voz de Polly en español de México: Andres (hombre; neural o generative) o Mia (mujer; también standard)
# Motor: standard ($4 / millón de caracteres), neural ($16) o generative ($30)
POLLY_VOICE=Andres
POLLY_ENGINE=neural

# Ciudad del clima por defecto (Open-Meteo, sin clave)
WEATHER_CITY=Ciudad de México
